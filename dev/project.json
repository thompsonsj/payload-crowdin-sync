{
  "name": "dev",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "dev/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/dev"],
      "options": {
        "command": "vitest run --project dev"
      },
      "configurations": {
        "ci": {
          "command": "vitest run --project dev --coverage --coverage.reportsDirectory=coverage/dev --coverage.include=dev/src/**/*.ts --coverage.include=plugin/src/**/*.ts"
        }
      }
    }
  }
}
