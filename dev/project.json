{
  "name": "dev",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "dev/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/dev",
        "main": "dev/src/index.ts",
        "tsConfig": "dev/tsconfig.lib.json",
        "assets": ["dev/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/dev"],
      "options": {
        "command": "vitest run --project dev"
      },
      "configurations": {
        "ci": {
          "command": "vitest run --project dev --coverage --coverage.reportsDirectory=coverage/dev --coverage.include=dev/src/**/*.ts --coverage.include=plugin/src/**/*.ts"
        }
      }
    }
  }
}
