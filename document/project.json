{
  "name": "document",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "document/src",
  "projectType": "library",
  "tags": ["scope:document"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/document",
        "main": "document/src/index.ts",
        "tsConfig": "document/tsconfig.build.json",
        "assets": ["document/*.md"],
        "updateBuildableProjectDepsInPackageJson": true
      }
    },
    "native-esm": {
      "command": "node tools/scripts/rewrite-dist-entrypoints.mjs dist/document && node tools/scripts/assert-native-esm.mjs dist/document",
      "dependsOn": ["build"]
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/document"],
      "options": {
        "command": "vitest run --project document"
      },
      "configurations": {
        "ci": {
          "command": "vitest run --project document --coverage --coverage.reportsDirectory=coverage/document --coverage.include=document/src/**/*.ts"
        }
      }
    }
  }
}
