{
  "name": "plugin",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "plugin/src",
  "projectType": "library",
  "tags": ["scope:plugin"],
  "implicitDependencies": ["document", "adapters"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/plugin",
        "main": "plugin/src/index.ts",
        "tsConfig": "plugin/tsconfig.build.json",
        "assets": ["plugin/*.md"],
        "updateBuildableProjectDepsInPackageJson": true
      }
    },
    "package": {
      "command": "node tools/scripts/vendor-workspace-packages.mjs && node tools/scripts/rewrite-dist-entrypoints.mjs dist/plugin",
      "cache": false,
      "dependsOn": ["build", "^build"]
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs plugin {args.ver} {args.tag}",
      "dependsOn": ["package"]
    },
    "native-esm": {
      "command": "node tools/scripts/assert-native-esm.mjs dist/plugin",
      "dependsOn": ["package"]
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/plugin"],
      "options": {
        "command": "vitest run --project plugin"
      },
      "configurations": {
        "ci": {
          "command": "vitest run --project plugin --coverage --coverage.reportsDirectory=coverage/plugin --coverage.include=plugin/src/**/*.ts --coverage.include=document/src/**/*.ts --coverage.include=adapters/src/**/*.ts"
        }
      }
    }
  }
}
