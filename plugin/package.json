{
  "name": "payload-crowdin-sync",
  "version": "0.46.0",
  "description": "Reorganise nested Payload CMS documents into compact HTML and JSON files for Crowdin translators. Groups, arrays, and Lexical blocks inside rich text become a small set of files. Fields that are not translatable stay in Payload.",
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "crowdin",
    "localization",
    "i18n",
    "translations",
    "cms"
  ],
  "homepage": "https://thompsonsj.github.io/payload-crowdin-sync/",
  "scripts": {
    "prettier": "npx prettier . --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thompsonsj/payload-crowdin-sync.git"
  },
  "author": "https://github.com/thompsonsj",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thompsonsj/payload-crowdin-sync/issues"
  },
  "dependencies": {
    "jsdom": "^29.1.1",
    "payload-localization-adapters": "1.1.0",
    "payload-localized-fields": "1.2.0",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "payload": "^3",
    "@payloadcms/db-mongodb": "^3",
    "@payloadcms/richtext-lexical": "^3",
    "@payloadcms/richtext-slate": "^3",
    "@payloadcms/ui": "^3",
    "react": "^19.0.0"
  },
  "type": "module",
  "files": [
    "src",
    "vendor",
    "*.md"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "volta": {
    "node": "23.5.0"
  }
}
